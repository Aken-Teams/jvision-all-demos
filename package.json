{
  "name": "jvision-all-demos",
  "version": "1.0.0",
  "private": true,
  "description": "JVision AI monorepo integrating 464 independently runnable demo projects.",
  "dependencies": {
    "@vercel/functions": "^3.7.5"
  },
  "scripts": {
    "vercel-build": "node -e \"console.log('Preparing JVision static demo hub')\"",
    "start": "npx serve .",
    "list:demos": "node tools/list-demos.js",
    "audit:structure": "node tools/audit-structure.js",
    "convert:next": "node tools/convert-generated-demos-to-next.mjs",
    "audit:next": "node tools/audit-generated-next-demos.mjs",
    "restore:legacy-next": "node tools/restore-legacy-next-runtime.mjs",
    "audit:legacy-next": "node tools/audit-legacy-next-runtime.mjs",
    "build:legacy-next": "node tools/build-legacy-next-batch.mjs",
    "apply:bright-saas": "node tools/apply-bright-saas-theme.mjs",
    "audit:bright-saas": "node tools/audit-bright-saas-theme.mjs",
    "apply:galaxy-saas": "node tools/apply-galaxy-saas-theme.mjs",
    "audit:galaxy-saas": "node tools/audit-galaxy-saas-theme.mjs",
    "audit:formal-sites": "node tools/audit-formal-websites.mjs",
    "apply:responsive-analytics": "node tools/apply-responsive-analytics.mjs",
    "apply:module-navigation": "node tools/add-module-navigation.mjs",
    "apply:demo-hub-navigation": "node tools/add-demo-hub-navigation.mjs",
    "apply:demo-button-feedback": "node tools/add-demo-button-feedback.mjs",
    "apply:deepseek-ai-advice": "node tools/add-deepseek-ai-advice.mjs",
    "test:deepseek-ai-advice": "node tools/test-deepseek-ai-advice.mjs",
    "apply:dynamic-charts": "node tools/add-dynamic-analytics-charts.mjs",
    "test:dynamic-charts": "node tools/test-dynamic-analytics-charts.mjs",
    "apply:distinct-modules": "node tools/build-distinct-functional-modules.mjs",
    "apply:practical-content": "node tools/apply-practical-content.mjs",
    "audit:practical-content": "node tools/audit-practical-content.mjs",
    "test:practical-workflows": "node tools/test-practical-workflows.mjs",
    "test:practical-homepage": "node tools/test-practical-homepage.mjs",
    "sync:project-titles": "node tools/sync-project-titles.mjs",
    "fix:generated-title-layout": "node tools/fix-generated-title-layout.mjs",
    "audit:generated-title-layout": "node tools/audit-generated-title-layout.mjs",
    "audit:mobile-analytics": "node tools/audit-mobile-analytics.mjs",
    "publish:demo-thumbnails": "node tools/publish-demo-thumbnails.mjs",
    "agent:project-expert": "node tools/project-expert-agent.mjs",
    "agent:project-expert:apply-safe": "node tools/apply-project-expert-fixes.mjs && node tools/add-domain-expert-panel.mjs && node tools/project-expert-agent.mjs --apply-safe",
    "apply:project-expert-fixes": "node tools/apply-project-expert-fixes.mjs",
    "apply:domain-expert": "node tools/add-domain-expert-panel.mjs && node tools/project-expert-agent.mjs --apply-safe",
    "test:domain-expert": "node tools/test-domain-expert.mjs",
    "apply:project-share": "node tools/add-project-share-controls.mjs",
    "test:project-share": "node tools/test-project-share.mjs",
    "test:project-expert": "node tools/project-expert-acceptance.mjs",
    "test:e2e:all": "node tools/e2e-all-demos.mjs",
    "test:module-navigation": "node tools/test-module-navigation.mjs",
    "clean:vercel-analytics": "node tools/remove-vercel-analytics.mjs",
    "use:single-domain": "node tools/use-single-domain-demo-urls.js"
  },
  "workspaces": [
    "demos/*"
  ]
}
