[Unit]
Description=JVision 訂單建置 worker（把付過款的需求單自動變成可用的系統）
After=caseshow.service

[Service]
Type=simple
WorkingDirectory=/home/aken/code/caseShow
ExecStart=/home/aken/.local/share/fnm/aliases/default/bin/node tools/order-worker.mjs --interval=30
Restart=always
RestartSec=30
# 這支不是 gateway 的子行程，獨立成單元才不會被 caseshow.service 的重啟連帶收掉
# （KillMode=control-group 會清掉整個 cgroup，換裝產線就是這樣被砍過）。
KillMode=mixed
TimeoutStopSec=90

[Install]
WantedBy=default.target
