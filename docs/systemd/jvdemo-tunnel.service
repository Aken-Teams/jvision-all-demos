[Unit]
Description=jvdemo.jvision-ai.com Cloudflare Tunnel（獨立於 nsysu-bm，勿合併）
After=network-online.target caseshow.service
Wants=network-online.target

[Service]
Type=simple
# 刻意用自己的設定檔與自己的 tunnel ID。與 nsysu-bm 共用一條的話，每次調整
# ingress 都得重啟該程序，bm.nsysugaa.com 會跟著中斷。
ExecStart=/home/aken/.local/bin/cloudflared tunnel --config /home/aken/.cloudflared/jvdemo.yml run
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jvdemo-tunnel

[Install]
WantedBy=default.target
