[Unit]
Description=JVision 客戶系統服務（實例執行時，:4700）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/aken/code/caseShow
# node 裝在 fnm 底下，systemd user manager 的 PATH 不含它。
Environment=PATH=/home/aken/.local/share/fnm/aliases/default/bin:/home/aken/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/aken/.local/share/fnm/aliases/default/bin/node tools/app-server.mjs
Restart=always
RestartSec=5

# 刻意與 caseshow.service 分開：那支重啟會連帶收掉 npx serve 與 python，
# 客戶的系統不該被型錄站的重啟牽連——他們正在裡面輸入資料。
[Install]
WantedBy=default.target
