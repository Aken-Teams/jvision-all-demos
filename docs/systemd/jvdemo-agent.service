[Unit]
Description=JV Demo 開發 Agent（每天自動產出 demo 並上架，額度見 docs/_state/agent-quota）
After=caseshow.service
Wants=caseshow.service

[Service]
Type=simple
WorkingDirectory=/home/aken/code/caseShow
# node 與 codex 都裝在使用者目錄底下，systemd user manager 的 PATH 不含它們。
Environment=PATH=/home/aken/.local/share/fnm/aliases/default/bin:/home/aken/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/bash tools/agent-loop.sh
# agent 自己會處理出題失敗與每日額度，正常情況不該退出；真的退了就重來。
Restart=always
RestartSec=60
# 停服務時要把 codex 子行程一起收掉。實測殘留的 codex 會活過父程序，
# 下次啟動時和新的 codex 搶同一份輸出檔。
KillMode=control-group
TimeoutStopSec=60
StandardOutput=append:/home/aken/code/caseShow/docs/_state/agent-loop.log
StandardError=append:/home/aken/code/caseShow/docs/_state/agent-loop.log
SyslogIdentifier=jvdemo-agent

[Install]
WantedBy=default.target
