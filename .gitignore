!.env.example

.vercel

# Python 快取（jvision-agents-office）
__pycache__/
*.pyc

# 備份檔
*.bak

# demo-publish 的 projects-index 備份（git 本身即為版本歷史）
docs/backups/

# gateway 使用紀錄（含訪客雜湊，不進版控）
var/

# agent 的單一執行鎖，純執行期產物
docs/_state/agent.lock

# 每日收尾的完成標記，純執行期產物
docs/_state/agent-wrapup-*
docs/_state/agent-watchdog.log
docs/_state/failed-transcripts/
docs/_state/eval-runs/

# ui-ux-pro-max 技能（第三方，用 npx ui-ux-pro-max-cli init --ai codex 安裝）
# 不進版控：它有自己的 repo 與授權，4.7MB 的資料檔混進來只會讓每次 clone 更慢。
.agents/
# agent 的暫停旗標，是當下的開關不是要留的內容
docs/_state/AGENT_STOP
