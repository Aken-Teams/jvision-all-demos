#!/usr/bin/env bash
# JV Demo 產線進度儀表
#
#   ./progress              看一次
#   ./progress -w           每 10 秒自動更新
#   ./progress -w 5         每 5 秒自動更新
#
# 資料來源是既有產物，程序沒在跑也查得到累計進度。
set -euo pipefail
cd "$(dirname "$0")"

case "${1:-}" in
  -w|--watch) exec node tools/forge-progress.mjs --watch --interval="${2:-10}" ;;
  -h|--help)  sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' ; exit 0 ;;
  *)          exec node tools/forge-progress.mjs "$@" ;;
esac
