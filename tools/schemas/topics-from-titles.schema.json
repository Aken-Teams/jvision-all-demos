{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["topics"],
  "properties": {
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["givenTitle", "slug", "title", "systemType", "category", "description",
          "businessSituation", "primaryUser", "dailyUse", "operationalMetrics",
          "modules", "flowStages", "differentiator"],
        "properties": {
          "givenTitle": { "type": "string", "description": "原樣抄回指定的系統名稱，用來對位" },
          "slug": { "type": "string", "description": "英文小寫連字號，4-40 字元，不含 jvision- 前綴" },
          "title": { "type": "string", "description": "站上顯示的中文名稱，6-16 字" },
          "systemType": { "type": "string" },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "businessSituation": { "type": "string" },
          "primaryUser": { "type": "string" },
          "dailyUse": { "type": "string" },
          "operationalMetrics": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "type": "string" } },
          "modules": {
            "type": "array", "minItems": 6, "maxItems": 6,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["icon", "name", "desc"],
              "properties": { "icon": { "type": "string" }, "name": { "type": "string" }, "desc": { "type": "string" } }
            }
          },
          "flowStages": {
            "type": "array", "minItems": 6, "maxItems": 6,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["title", "role", "desc"],
              "properties": { "title": { "type": "string" }, "role": { "type": "string" }, "desc": { "type": "string" } }
            }
          },
          "differentiator": { "type": "string", "description": "跟站上哪一個既有題目最像、差在哪" }
        }
      }
    }
  }
}
