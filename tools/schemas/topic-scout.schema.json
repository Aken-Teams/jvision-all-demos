{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topics"
  ],
  "properties": {
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "title",
          "systemType",
          "category",
          "description",
          "businessSituation",
          "primaryUser",
          "dailyUse",
          "operationalMetrics",
          "modules",
          "flowStages",
          "differentiator"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{3,40}$",
            "description": "英文小寫連字號；repoName 會是 jvision-<slug>"
          },
          "title": {
            "type": "string",
            "minLength": 4,
            "maxLength": 20,
            "description": "6-14 個中文字的系統名稱"
          },
          "systemType": {
            "type": "string",
            "enum": [
              "sales-crm",
              "manufacturing-mes",
              "erp",
              "warehouse-wms",
              "procurement-srm",
              "quality-qms",
              "analytics-bi",
              "esg-energy",
              "pos-frontdesk",
              "hr-hris",
              "finance-ledger",
              "finance-case",
              "it-ops",
              "security-soc",
              "education-lms",
              "healthcare-clinic",
              "construction-pm",
              "maintenance-cmms",
              "logistics-fleet",
              "legal-case",
              "collaboration-pm",
              "service-desk",
              "operations-console"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "ESG 永續",
              "交通運輸",
              "人力資源",
              "企業協作",
              "倉儲物流",
              "品質管理",
              "宗教服務",
              "客服管理",
              "專業服務",
              "房地產與物業",
              "採購供應鏈",
              "教育",
              "數據分析",
              "業務銷售",
              "營建工程",
              "物流運輸",
              "生活服務",
              "生產製造",
              "研發管理",
              "經營管理",
              "設備維護",
              "財務會計",
              "資訊安全",
              "資訊科技",
              "醫療照護",
              "金融保險",
              "零售電商",
              "餐飲旅宿"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 40,
            "maxLength": 200
          },
          "businessSituation": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200
          },
          "primaryUser": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60,
            "description": "頓號分隔，2-3 種角色"
          },
          "dailyUse": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200
          },
          "operationalMetrics": {
            "type": "array",
            "minItems": 3,
            "maxItems": 5,
            "items": {
              "type": "string",
              "maxLength": 20
            }
          },
          "modules": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "icon",
                "name",
                "desc"
              ],
              "properties": {
                "icon": {
                  "type": "string",
                  "description": "Material Symbols Outlined 名稱"
                },
                "name": {
                  "type": "string",
                  "maxLength": 12
                },
                "desc": {
                  "type": "string",
                  "maxLength": 40
                }
              }
            }
          },
          "flowStages": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "role",
                "desc"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 14
                },
                "role": {
                  "type": "string",
                  "maxLength": 10
                },
                "desc": {
                  "type": "string",
                  "maxLength": 50
                }
              }
            }
          },
          "differentiator": {
            "type": "string",
            "minLength": 10,
            "maxLength": 120,
            "description": "跟哪一個既有題目最像、差在哪"
          }
        }
      }
    }
  }
}
