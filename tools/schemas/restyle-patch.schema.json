{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "styleBlock",
    "edits",
    "style"
  ],
  "properties": {
    "edits": {
      "type": "array",
      "minItems": 0,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "find",
          "replace"
        ],
        "properties": {
          "find": {
            "type": "string",
            "minLength": 12,
            "maxLength": 4000,
            "description": "要被取代的原文片段，必須逐字元完全等同檔案裡的內容，且在整份檔案中只出現一次。用在標記或 <head> 的小改動；CSS 不要放這裡，放 styleBlock。"
          },
          "replace": {
            "type": "string",
            "maxLength": 8000,
            "description": "換上去的新內容"
          }
        }
      }
    },
    "style": {
      "type": "string",
      "maxLength": 60,
      "description": "這次採用的風格名稱"
    },
    "styleBlock": {
      "type": "string",
      "maxLength": 60000,
      "description": "整個 <style> 區塊的新內容（不要含 <style> 標籤本身）。換裝的主要工作在這裡。不需要動樣式時給空字串。"
    }
  }
}