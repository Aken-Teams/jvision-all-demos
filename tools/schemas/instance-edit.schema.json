{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "edits",
    "note",
    "steps_done",
    "steps_skipped"
  ],
  "properties": {
    "edits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "find",
          "replace"
        ],
        "properties": {
          "find": {
            "type": "string",
            "minLength": 12,
            "maxLength": 4000,
            "description": "要被取代的原文片段，必須逐字元完全等同檔案裡的內容，而且在整份檔案中只出現一次"
          },
          "replace": {
            "type": "string",
            "maxLength": 8000,
            "description": "換上去的新內容。要刪掉那一段就給空字串"
          }
        }
      }
    },
    "note": {
      "type": "string",
      "maxLength": 40,
      "description": "這次改了什麼，**15 字以內的短標題**，繁體中文。例如「加通知中心」「補登入畫面」。這一行會出現在版本清單上當標題，寫成完整說明句就會被截斷"
    },
    "steps_done": {
      "type": "array",
      "maxItems": 8,
      "description": "上面那份做法清單裡，這次真的做完的步驟編號（從 1 開始）。沒有給過清單就給空陣列",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8
      }
    },
    "steps_skipped": {
      "type": "array",
      "maxItems": 8,
      "description": "沒做的步驟與原因。全部做完就給空陣列",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "why"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "why": {
            "type": "string",
            "maxLength": 100,
            "description": "為什麼沒做，繁體中文"
          }
        }
      }
    }
  }
}
