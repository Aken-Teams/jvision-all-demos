{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["headers", "rows"],
  "properties": {
    "headers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 20,
        "description": "這個領域真的會用的欄位名稱，繁體中文" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 12,
        "items": { "type": "string", "maxLength": 40,
          "description": "該欄位的真實資料。最後一欄是狀態標籤，值要短" }
      }
    }
  }
}
