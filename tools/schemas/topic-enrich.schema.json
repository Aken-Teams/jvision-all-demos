{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apps"
  ],
  "properties": {
    "apps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "masterId",
          "slug",
          "systemType",
          "description",
          "modules",
          "flowStages"
        ],
        "properties": {
          "masterId": {
            "type": "string",
            "description": "對應輸入的編號，例如 JV-001"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{3,40}$",
            "description": "英文小寫連字號，描述性，例如 agent-blueprint-designer"
          },
          "systemType": {
            "type": "string",
            "description": "從給定清單挑一個最貼近的"
          },
          "description": {
            "type": "string",
            "minLength": 30,
            "maxLength": 120,
            "description": "一句話講清楚這個系統解決什麼工作"
          },
          "modules": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "icon",
                "name",
                "desc"
              ],
              "properties": {
                "icon": {
                  "type": "string",
                  "description": "Material Symbols Outlined 名稱"
                },
                "name": {
                  "type": "string",
                  "maxLength": 10
                },
                "desc": {
                  "type": "string",
                  "maxLength": 34
                }
              }
            }
          },
          "flowStages": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "role",
                "desc"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 12
                },
                "role": {
                  "type": "string",
                  "maxLength": 8
                },
                "desc": {
                  "type": "string",
                  "maxLength": 44
                }
              }
            }
          }
        }
      }
    }
  }
}
