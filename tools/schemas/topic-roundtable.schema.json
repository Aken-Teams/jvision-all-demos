{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["ideas"],
  "properties": {
    "ideas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "category", "scene", "who", "pain", "whyBuy"],
        "properties": {
          "title": { "type": "string", "description": "6-14 個中文字的系統名稱" },
          "category": { "type": "string", "description": "必須是配額表列出的產業之一" },
          "scene": { "type": "string", "description": "這套系統在企業裡的哪個作業環節被打開，60-120 字" },
          "who": { "type": "string", "description": "每天實際操作的角色" },
          "pain": { "type": "string", "description": "沒有這套系統時，這件事今天是怎麼做的、會出什麼錯" },
          "whyBuy": { "type": "string", "description": "企業為什麼願意付錢買，講可量化的損失或風險" }
        }
      }
    }
  }
}
