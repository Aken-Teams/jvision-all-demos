{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "screens",
    "stageMapping",
    "chartLib",
    "selfCheck"
  ],
  "properties": {
    "screens": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "name",
          "summary",
          "charts"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "charts": {
            "type": "integer"
          }
        }
      }
    },
    "stageMapping": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "screen"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "screen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        }
      }
    },
    "chartLib": {
      "type": "string",
      "enum": [
        "echarts",
        "chartjs",
        "apexcharts"
      ]
    },
    "selfCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "syntaxChecked",
        "noTimers",
        "rwdChecked"
      ],
      "properties": {
        "syntaxChecked": {
          "type": "boolean"
        },
        "noTimers": {
          "type": "boolean"
        },
        "rwdChecked": {
          "type": "boolean"
        }
      }
    }
  }
}
