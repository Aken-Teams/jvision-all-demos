{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "understanding",
    "steps",
    "risks"
  ],
  "properties": {
    "understanding": {
      "type": "string",
      "maxLength": 200,
      "description": "一句話說明你認為使用者要的是什麼。要用他看得懂的話，不要講程式術語"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "description": "打算做的事，照執行順序。只列真的要動的，不要為了湊數把「檢查」「測試」寫成步驟",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "why"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 50,
            "description": "一句話，動詞開頭，繁體中文。例如「在申請表單加一個備註輸入框」"
          },
          "why": {
            "type": "string",
            "maxLength": 100,
            "description": "為什麼這一步是必要的。使用者沒明講但你認為該做的，這裡要說清楚理由。真的沒什麼好說就給空字串"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 3,
      "description": "這次改動可能踩到的地方。沒有就給空陣列（這個欄位一定要出現）",
      "items": {
        "type": "string",
        "maxLength": 100
      }
    }
  }
}
