{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "understanding",
    "steps",
    "risks"
  ],
  "properties": {
    "understanding": {
      "type": "string",
      "maxLength": 60,
      "description": "一句話說明你認為使用者要的是什麼。要短，30 字以內，用他看得懂的話，不要講程式術語"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "description": "打算做的事，照執行順序。只列真的要動的，不要為了湊數把「檢查」「測試」寫成步驟",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "why"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 28,
            "description": "動詞開頭的短句，20 字以內。例如「在申請表單加備註輸入框」。不要寫成完整說明句"
          },
          "why": {
            "type": "string",
            "maxLength": 40,
            "description": "只在「使用者沒說、但非做不可」時才寫，20 字以內的一句短話（例如「只改表格的話沒地方填」）。理由顯而易見就給空字串"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 2,
      "description": "真的會出事的地方，25 字以內一則，最多兩則。沒有就給空陣列（這個欄位一定要出現）",
      "items": {
        "type": "string",
        "maxLength": 50
      }
    }
  }
}
